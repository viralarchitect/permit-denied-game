# South gate → around the spawn concrete (x<256) → sheriff pad, blade down.
# Cruisers spawn at t=0 and may peel; a peel is a real fail, not a skip.
tap space
assert scene=play
tap space
assert blade=down
hold a 18
hold w,a 90
hold w 240
dump at-sheriff.json
shot at-sheriff.png
assert scene=play
hold w 180
dump after-push.json
shot after-push.png
assert sheriff_hp<60
